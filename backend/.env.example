# Copy this file to .env and fill in your own values

# MongoDB connection string.
# Local MongoDB example:  mongodb://127.0.0.1:27017/taskflow
# MongoDB Atlas example:  mongodb+srv://<user>:<password>@cluster0.mongodb.net/taskflow
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Secret key used to sign JWT tokens. Use any long random string.
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the backend server will run on
PORT=5000
